# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/smartnms

# JWT
JWT_SECRET=change-this-in-production
JWT_REFRESH_SECRET=change-this-in-production

# CORS
CORS_ORIGIN=http://localhost:5173

# Monitoring
PING_INTERVAL_MS=30000
PING_TIMEOUT_MS=5000
OFFLINE_FAILURE_THRESHOLD=3

# Advanced collectors
SNMP_ENABLED=true
SNMP_INTERVAL_MS=60000
SSH_ENABLED=true
SSH_INTERVAL_MS=120000

# Security / encryption
ENCRYPTION_KEY=change-this-32-byte-secret-in-production

# Reports
REPORT_OUTPUT_DIR=storage/reports
REPORT_TTL_HOURS=168

# Anomaly detection
ANOMALY_ENABLED=true
ANOMALY_INTERVAL_MS=300000
ANOMALY_MIN_SAMPLES=12
ANOMALY_ZSCORE_THRESHOLD=3

# OpenTelemetry
OTEL_ENABLED=false
OTEL_SERVICE_NAME=smartnms-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
